# one way to perform effects from slug:
# pass in effectful functions from the host language.
# While I personally don't love this approach
# (slug code execution won't be guaranteed to be effect-free anymore),
# it is inarguably convenient and intuitive.
# A small difference compared to zigs virtual dispatch Io:
# The internal io state is parameterized, so slug functions
# can work with whatever implementation-specific data you feed it

fn print-random-quote(
    {
        io io Io
        http-get http-get fn(Io str) opt(span(* char))
        stdout-write-char-slice
            stdout-write-char-slice fn(Io opt(span(* char))) *
        stdout-flush stdout-flush fn(Io) *
    }
)
    *
    = _ buf-empty<* char>()
    = quote-response
        http-get(io "https://dummyjson.com/quotes/random"str)
    = to-write
        add-str-chars<*>("Corporate quote of the day: \""str)
        .span-add-own-opt-span(
            # this isn't how one would actually parse json of course
            quote-response
            .opt-span-strip-start-to-after-str-chars("quote\":\""str)
            .opt-span-strip-end-to-before-str-chars("\",\"author"str)
        )
        .span-add-str-chars("\"\n"str)
    = * stdout-write-char-slice(io Yes<[No]>(to-write))
    stdout-flush(io)

# the rest of the file is just a few string helpers

fn opt-span-strip-start-to-after-str-chars(
    opt-span opt(span(Chars char))
    excluded-end str
)
    opt(span(Chars char))
    if opt-span.opt-span-after-str-chars(excluded-end) {
        Yes(after-end) after-end
        No
            if opt-span {
                No No<opt(span(Chars char))>
                Yes(span)
                    = *(_ after) span-start(span)
                    opt-span-strip-start-to-after-str-chars(after excluded-end)
            }
    }

fn opt-span-strip-end-to-before-str-chars(
    opt-span opt(span(Chars char))
    excluded-end str
)
    opt(span(Chars char))
    if opt-span.opt-span-before-str-chars(excluded-end) {
        Yes(after-end) after-end
        No
            if opt-span {
                No No<opt(span(Chars char))>
                Yes(span)
                    = *(before _) span-end(span)
                    opt-span-strip-end-to-before-str-chars(before excluded-end)
            }
    }
