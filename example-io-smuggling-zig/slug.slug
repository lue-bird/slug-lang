# one way to perform effects from slug:
# pass in effectful functions from the host language.
# While I personally don't love this approach
# (slug code execution won't be guaranteed to be effect-free anymore),
# it is inarguably convenient and intuitive.
# A small difference compared to zigs virtual dispatch Io:
# The internal io state is parameterized, so slug functions
# can work with whatever implementation-specific data you feed it

fn print-random-quote(
    {
    io io Io
    http-get http-get fn(Io str) opt(span([Chars] char))
    stdout-write-char-slice
        stdout-write-char-slice fn(Io opt(span([Chars] char))) *
    stdout-flush stdout-flush fn(Io) *
    }
)
    *
    = _ buf-empty<[Chars] char>()
    = quote-response
        http-get(io "https://dummyjson.com/quotes/random"str)
    = to-write
        add-str-chars<[Chars]>("Corporate quote of the day: \""str)
        .span-add-own-opt-span(
            # this isn't how one would actually parse json of course
            quote-response
            .opt-span-strip-start-to-after-str-chars("quote\":\""str)
            .opt-span-strip-end-to-before-str-chars("\",\"author"str)
        )
        .span-add-str-chars("\"\n"str)
    = * stdout-write-char-slice(io Yes<[No]>(to-write))
    stdout-flush(io)

# the rest of the file is just a few string helpers

fn opt-span-strip-start-to-after-str-chars(
    opt-span opt(span(Chars char))
    excluded-end str
)
    opt(span(Chars char))
    if opt-span-strip-start-str-chars(opt-span excluded-end) {
    Prefixed(after-end) after-end
    Not-prefixed
        if opt-span {
        No No<opt(span(Chars char))>
        Yes(span)
            = *(_ after) span-start(span)
            opt-span-strip-start-to-after-str-chars(after excluded-end)
        }
    }

fn opt-span-strip-end-to-before-str-chars(
    opt-span opt(span(Chars char))
    excluded-end str
)
    opt(span(Chars char))
    if opt-span-strip-end-str-chars(opt-span excluded-end) {
    Prefixed(after-end) after-end
    Not-prefixed
        if opt-span {
        No No<opt(span(Chars char))>
        Yes(span)
            = *(before _) span-end(span)
            opt-span-strip-end-to-before-str-chars(before excluded-end)
        }
    }

fn opt-span-strip-start-str-chars(
    span opt(span(Chars char))
    prefix str
)
    [Not-prefixed Prefixed(opt(span(Chars char)))]
    = step-result
        opt-span-step-while(
            span
            Up<[Down]>
            prefix
            fn(state str slot slot(Chars char))
                = *(str-start opt-str-after) str-start(state)
                if u32-order(char-to-u32(item(slot)) char-to-u32(str-start)) {
                Equal
                    if opt-str-after {
                    No Done<[Going(str)]>(Prefixed<[Not-prefixed]>)
                    Yes(str-after) Going<[Done([Prefixed Not-prefixed])]>(str-after)
                    }
                _ Done<[Going(str)]>(Not-prefixed<[Prefixed]>)
                }
        )
    if step-result {
    Going(_)
        Not-prefixed<[Prefixed(opt(span(Chars char)))]>
    Done(Not-prefixed _)
        Not-prefixed<[Prefixed(opt(span(Chars char)))]>
    Done(Prefixed span-after)
        Prefixed<[Not-prefixed]>(span-after)
    }

fn opt-span-strip-end-str-chars(
    span opt(span(Chars char))
    suffix str
)
    [Not-prefixed Prefixed(opt(span(Chars char)))]
    = step-result
        opt-span-step-while(
            span
            Down<[Up]>
            suffix
            fn(state str slot slot(Chars char))
                = *(opt-str-before str-end) str-end(state)
                if u32-order(char-to-u32(item(slot)) char-to-u32(str-end)) {
                Equal
                    if opt-str-before {
                    No Done<[Going(str)]>(Prefixed<[Not-prefixed]>)
                    Yes(str-before) Going<[Done([Prefixed Not-prefixed])]>(str-before)
                    }
                _ Done<[Going(str)]>(Not-prefixed<[Prefixed]>)
                }
        )
    if step-result {
    Going(_)
        Not-prefixed<[Prefixed(opt(span(Chars char)))]>
    Done(Not-prefixed _)
        Not-prefixed<[Prefixed(opt(span(Chars char)))]>
    Done(Prefixed span-after)
        Prefixed<[Not-prefixed]>(span-after)
    }
