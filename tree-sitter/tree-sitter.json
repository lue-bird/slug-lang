{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "slug",
      "camelcase": "slug",
      "title": "slug",
      "scope": "source.slug",
      "file-types": ["slug"],
      "injection-regex": "^slug$",
      "class-name": "TreeSitterSlug"
    }
  ],
  "metadata": {
    "version": "0.1.2",
    "license": "Unlicense",
    "description": "slug grammar for tree-sitter",
    "authors": [
      {
        "name": "lue-bird"
      }
    ],
    "links": {
      "repository": "https://github.com/lue-bird/slug-lang"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
